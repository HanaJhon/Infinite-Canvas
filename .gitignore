# 敏感信息
API/.env

# 运行时数据
assets/
data/*
# data/ 是混装目录：绝大多数是用户数据（api_providers.json 含 API 密钥、
# canvases/ 画布、chat_*.json 会话、asset_library.json 素材库索引……），
# 只有下面这一个文件是随程序分发的只读资源，才允许入库。
# ⚠️ 不要往这里加例外 —— 加之前先确认该文件不含用户内容，
#    并且覆盖安装时覆盖它不会损坏用户状态（asset_library.json 就踩过这个坑：
#    它被用户写入后，覆盖安装会把素材库索引清回空骨架）。
!data/inspire_prompt_zh.json

# 系统文件
.DS_Store
__pycache__/
*.pyc
history.json

# 调试产物
.qoder/
inspire_image_dims.json

# 启动器构建产物
dist/
launcher/bin/
launcher/obj/

# 启动器运行时的 WebView2 缓存（用户级运行状态，非源码）
*.exe.WebView2/

# 运行/验证产物：生成结果、分层 PSD、画布备份都在这里。
# 都可由程序重新生成，且 output/backup/ 里含真实画布数据（个人内容），不入库。
# 已跟踪的 output/step*.png 不受影响；确实要提交某个产物用 git add -f。
output/

# 一次性验证探针页（用完即删，别误提交）
static/__*.html
