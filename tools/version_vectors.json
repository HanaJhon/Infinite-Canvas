{
  "_comment": "版本规则自测向量表。Python（tools/versioning.py）与 C#（launcher/VersionUtil.cs）共用同一份数据，避免两份实现漂移。normalize 两边都直接跑；bump 只有 Python 有（C# 不做递增），C# 侧用 normalize(末段+1) 反查，等价于同一个断言。",
  "_spec": "三段式，从 1.1.1 起算；末段满 10 → 中段 +1、末段归 0；中段满 10 → 首段 +1 并丢掉归零的末段；首段满 10 不再进位。即「每多进一级就少一段」。",
  "normalize": [
    ["", ""],
    ["1.1.1", "1.1.1"],
    ["1.1.9", "1.1.9"],
    ["1.1.10", "1.2.0"],
    ["1.2.0", "1.2.0"],
    ["1.9.9", "1.9.9"],
    ["1.9.10", "2.0"],
    ["1.10.0", "2.0"],
    ["2.0", "2.0"],
    ["2.9", "2.9"],
    ["9.9", "9.9"],
    ["9.10", "10"],
    ["10", "10"],
    ["10.0", "10"],
    ["1.10.10", "2.1"],
    ["2026.09.20", "2026.09.20"]
  ],
  "bump": [
    ["1.1.1", "1.1.2"],
    ["1.1.2", "1.1.3"],
    ["1.1.8", "1.1.9"],
    ["1.1.9", "1.2.0"],
    ["1.2.0", "1.2.1"],
    ["1.2.8", "1.2.9"],
    ["1.2.9", "1.3.0"],
    ["1.9.8", "1.9.9"],
    ["1.9.9", "2.0"],
    ["2.0", "2.1"],
    ["2.9", "3.0"],
    ["9.8", "9.9"],
    ["9.9", "10"],
    ["10", "11"],
    ["11", "12"],
    ["2026.09.20", ""]
  ]
}
